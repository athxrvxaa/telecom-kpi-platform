# Copy to orchestration/.env and fill in. Path to YOUR gcloud Application Default Credentials file.
# Windows default: C:/Users/<you>/AppData/Roaming/gcloud/application_default_credentials.json
# (use forward slashes). NEVER commit the real .env or share that credentials file.
GCP_ADC_PATH=C:/Users/YOUR_USER/AppData/Roaming/gcloud/application_default_credentials.json
